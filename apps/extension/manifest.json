{
  "manifest_version": 3,
  "name": "Readio Companion",
  "version": "0.1.0",
  "description": "Capture web reading locally with Readio and optionally read it aloud",
  "action": {
    "default_title": "Readio",
    "default_popup": "popup.html"
  },
  "permissions": ["activeTab", "storage", "scripting", "tabs"],
  "host_permissions": [
    "http://localhost:8000/*",
    "http://127.0.0.1:8000/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}
