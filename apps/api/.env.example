READIO_ENV=dev
READIO_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
READIO_LIBRARY_DB_PATH=./data/readio.db

TTS_FALLBACK_ORDER=edge,minimax,elevenlabs
TTS_TIMEOUT_SECONDS=20

ELEVENLABS_API_KEY=
ELEVENLABS_BASE_URL=https://api.elevenlabs.io
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_VOICE_ID=

MINIMAX_API_KEY=
# Optional: if your account requires GroupId
MINIMAX_GROUP_ID=
# Optional full endpoint override, e.g. https://api.minimax.chat/v1/t2a_v2
MINIMAX_API_URL=
MINIMAX_BASE_URL=https://api.minimax.io
MINIMAX_MODEL_ID=speech-2.6-hd
MINIMAX_VOICE_ID=English_expressive_narrator

# Edge TTS (no API key required, multilingual cloud voices)
EDGE_TTS_VOICE=en-US-AriaNeural
